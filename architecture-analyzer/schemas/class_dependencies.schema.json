{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "class_dependencies.schema.json",
  "type": "object", "required": ["schema_version", "class_dependencies"], "additionalProperties": false,
  "properties": {"schema_version": {"const": "1.0"}, "class_dependencies": {"type": "array", "items": {
