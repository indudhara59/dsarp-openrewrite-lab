{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "component_dependencies.schema.json",
  "type": "object", "required": ["schema_version", "component_dependencies"], "additionalProperties": false,
  "properties": {"schema_version": {"const": "1.0"}, "component_dependencies": {"type": "array", "items": {
    "type": "object", "required": ["source_component", "target_component", "weight"], "additionalProperties": false,
    "properties": {"source_component": {"type": "string"}, "target_component": {"type": "string"}, "weight": {"type": "integer", "minimum": 1}}
  }}}
}
