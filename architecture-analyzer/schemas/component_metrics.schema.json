      "fan_in": {"type": "integer"}, "fan_out": {"type": "integer"}, "internal_class_dependency_count": {"type": "integer"},
      "internal_dependency_density": {"type": "number"}, "percentage_total_production_classes": {"type": "number"},
      "percentage_total_production_loc": {"type": "number"}, "degree_centrality": {"type": "number"}
    }
  }}}
}
